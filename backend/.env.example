# ─── Environment & Server ──────────────────────────────────────────────────
PROJECT_NAME="ORCA Marine Intelligence"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
LOG_LEVEL="info"

# ─── Security & CORS ──────────────────────────────────────────────────────
SECRET_KEY="replace-this-with-a-secure-random-secret-key"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─── LLM / AI Provider ────────────────────────────────────────────────────
# Your API key for the chosen LLM provider (OpenAI, Google Gemini, Anthropic, etc.)
LLM_API_KEY=""
# Provider name: "openai" | "google" | "anthropic"
LLM_PROVIDER=""

# ─── ISRO Bhuvan Geoportal ────────────────────────────────────────────────
# Register at https://bhuvan.nrsc.gov.in and generate an access token
BHUVAN_ACCESS_TOKEN=""

# ─── India Meteorological Department (optional) ───────────────────────────
# Sign up at https://mausam.imd.gov.in for API access (leave blank if unused)
IMD_API_KEY=""

# ─── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string, e.g. "postgresql+asyncpg://user:pass@localhost:5432/orca"
DATABASE_URL=""

# ─── Vector Store ─────────────────────────────────────────────────────────
# Path or URI for the vector database (e.g. ChromaDB directory "./data/vector_db")
VECTOR_DB_PATH=""

# ─── External ISRO / INCOIS / NavIC Data Connectors ───────────────────────
MOSDAC_API_BASE_URL="https://mosdac.gov.in/api"
# Register at https://mosdac.gov.in for satellite data access
MOSDAC_API_KEY=""
# MOSDAC SSO Account Credentials for official Data Download API (leave blank for local archive mode)
MOSDAC_USERNAME=""
MOSDAC_PASSWORD=""
# Verified Dataset ID for Oceansat-3 (EOS-06) OCM-3 Level-4 Analyzed Chlorophyll 25km
MOSDAC_DATASET_ID="E06OCM_L4_AC"
# Path to the primary local MOSDAC NetCDF archive file
MOSDAC_NETCDF_PATH="C:\\home\\sys_oper\\MOSDAC_Downloads\\E06OCML4AC_20260903_25km_v1.0.1.nc"
# Directory for caching downloaded MOSDAC NetCDF datasets
MOSDAC_DOWNLOAD_DIR="C:\\home\\sys_oper\\MOSDAC_Downloads"
# Optional direct remote download endpoint (or leave blank to use official API)
MOSDAC_REMOTE_URL=""
# Data freshness threshold in hours (observations older than this are classified as stale)
MOSDAC_MAX_FILE_AGE_HOURS=24.0
# Download request timeout in seconds
MOSDAC_DOWNLOAD_TIMEOUT=30.0
# Automatic authenticated download flag (set to true to enable automated retrieval when credentials are set)
MOSDAC_AUTO_DOWNLOAD_ENABLED=false
# Maximum number of validated NetCDF dataset files to retain in cache (older files pruned safely)
MOSDAC_MAX_CACHED_FILES=2
# Days to look back for available products (accounts for standard ~24h Level-4 publication latency)
MOSDAC_LOOKBACK_DAYS=3
MOSDAC_DOWNLOAD_COUNT=1
# Refresh interval in hours to prevent repeated downloads across consecutive queries
MOSDAC_REFRESH_INTERVAL_HOURS=24.0
# Bounding box for regional search (min_lon,min_lat,max_lon,max_lat for Indian coastal waters)
MOSDAC_BOUNDING_BOX="60,5,95,25"
# Optional explicit path to official mdapi.py client (defaults to app/services/mosdac_client/mdapi.py)
MOSDAC_CLIENT_PATH=""

INCOIS_ERDDAP_BASE_URL="https://erddap.incois.gov.in/erddap"
# Register at https://incois.gov.in for ocean data services
INCOIS_API_KEY=""

NAVIC_GATEWAY_URL="https://navic-hub.isro.gov.in/api"
# NavIC positioning gateway API key from ISRO
NAVIC_API_KEY=""

# ─── Emergency & Alerting Gateways ────────────────────────────────────────
COAST_GUARD_MRCC_WEBHOOK_URL="https://mrcc-alerts.indiancoastguard.gov.in/webhook"
SMS_GATEWAY_API_URL="https://sms-gateway.gov.in/api/send"
SMS_GATEWAY_API_KEY=""

# ─── Background Polling Interval (in seconds) ─────────────────────────────
ALERT_POLL_INTERVAL_SECONDS=300
