# Backend API Base URL
VITE_API_BASE_URL="http://localhost:8000"

# Geospatial Tile Layer URLs (CartoDB Voyager / OpenStreetMap / ISRO Bhuvan / MapLibre)
VITE_MAP_TILE_URL="https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png"

# Map Provider API Key (Required for providers like MapTiler, Stadia, Mapbox, or Google Maps)
# Leave blank for OpenStreetMap or CartoDB Voyager public tier
VITE_MAP_API_KEY=""

# ISRO Bhuvan Geoportal Tile Layer & Token (Optional)
VITE_BHUVAN_TILE_URL="https://bhuvan.nrsc.gov.in/tilecache/tilecache.py/1.0.0/bhuvan_nu2/{z}/{x}/{y}.png"
VITE_BHUVAN_ACCESS_TOKEN=""
